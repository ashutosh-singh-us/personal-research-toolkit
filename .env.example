# Your Confluence base URL (no trailing slash)
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki

# Your Aha.io base URL (no trailing slash)
AHA_BASE_URL=https://your-company.aha.io

# Aha.io API key is NOT stored here — it lives in ~/mcp-servers/aha_mcp.env
# and is passed to both the Docker container and the CLI via --env-file.
# See aha-mcp-server/README.md for setup instructions.
